# Copy to server-tls.conf to enable TLS termination in nginx.
# Included from the http block of nginx.conf, so upstreams and the shared
# proxy_set_header directives above are already in scope.

server {
    listen 443 ssl;
    http2 on;
    server_name your.domain;

    ssl_certificate     /etc/nginx/tls/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_stapling on;
    ssl_stapling_verify on;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    client_max_body_size 4g;
    limit_conn perip 64;

    add_header X-Content-Type-Options     nosniff                         always;
    add_header X-Frame-Options            DENY                            always;
    add_header Referrer-Policy            strict-origin-when-cross-origin always;
    add_header Cross-Origin-Opener-Policy same-origin                     always;

    location = /flow/api/clip-jobs {
        limit_req zone=clipcreate burst=5 nodelay;
        limit_req zone=api burst=60 nodelay;
        proxy_pass http://flow_upstream/api/clip-jobs;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /flow/ {
        limit_req zone=api burst=60 nodelay;
        proxy_pass http://flow_upstream/;
        proxy_request_buffering off;
        proxy_buffering off;
        gzip off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_set_header Connection '';
    }

    location /api/auth/ {
        limit_req zone=auth burst=20 nodelay;
        proxy_pass http://backend_upstream;
    }

    location = /api/events/stream {
        proxy_pass http://backend_upstream;
        proxy_buffering off;
        gzip off;
        proxy_read_timeout 3600s;
        proxy_set_header Connection '';
    }

    location /api/ {
        limit_req zone=api burst=60 nodelay;
        proxy_pass http://backend_upstream;
        proxy_read_timeout 300s;
    }

    location /docs        { proxy_pass http://backend_upstream; }
    location /openapi.json { proxy_pass http://backend_upstream; }

    location /remote/ {
        proxy_pass http://backend_upstream;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
    }

    location / {
        proxy_pass http://frontend_upstream;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}

# When this file is active, replace the plain server in nginx.conf with:
#
# server {
#     listen 80;
#     server_name _;
#     location = /nginx-health { access_log off; return 200 "ok\n"; }
#     location / { return 301 https://$host$request_uri; }
# }
