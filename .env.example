POSTGRES_DB=flowmeta
POSTGRES_USER=flowmeta
POSTGRES_PASSWORD=change-me

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=replace-with-fernet-key
FLOWMETA_TOKEN_SECRET=replace-with-long-random-secret

BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Meta app credentials used to exchange short-lived user tokens into long-lived
# user tokens (~60 days) during UID|TOKEN import.
META_APP_ID=
META_APP_SECRET=
AUTO_EXCHANGE_LONG_LIVED_TOKEN=true
TOKEN_REFRESH_THRESHOLD_DAYS=14
FACEBOOK_OAUTH_REDIRECT_URI=http://localhost:8000/api/facebook/oauth/callback
FACEBOOK_OAUTH_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts
FACEBOOK_OAUTH_SUCCESS_URL=http://localhost:3000/accounts

# Application sign-in OAuth (Google/Facebook quick login)
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/oauth/google/callback
AUTH_FACEBOOK_APP_ID=
AUTH_FACEBOOK_APP_SECRET=
AUTH_FACEBOOK_REDIRECT_URI=http://localhost:8000/api/auth/oauth/facebook/callback
AUTH_FRONTEND_CALLBACK_URL=http://localhost:3000/auth/callback
PASSWORD_RESET_URL=http://localhost:3000/reset-password
# Development only. Keep false in production until email delivery is configured.
EXPOSE_PASSWORD_RESET_TOKEN=false

BROWSER_PROFILE_DIR=/app/browser-profiles
UPLOAD_DIR=/app/uploads
COMMENT_IMAGE_MAX_BYTES=10485760
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
BROWSER_PROVIDER=kasm
BROWSERLESS_WS_URL=ws://browserless:3000/chromium
BROWSERLESS_CONCURRENT=5
BROWSERLESS_TIMEOUT=300000
BROWSER_SESSION_TTL_SECONDS=1800
MAX_BROWSER_SESSIONS_PER_USER=1
MAX_BROWSER_SESSIONS_GLOBAL=10
BROWSER_WORKER_CONCURRENCY=1

# Dev/fallback noVNC browser. Start with:
# docker compose --profile dev-browser up -d remote-browser
REMOTE_BROWSER_PORT=3010
REMOTE_BROWSER_BASE_URL=http://localhost:3010
# Public URL that backend returns for /remote/{session_id}.
REMOTE_BROWSER_PUBLIC_BASE_URL=http://localhost:8000
# Kasm/KasmVNC visible login provider.
KASM_IMAGE=kasmweb/chrome:1.19.0
KASM_DOCKER_NETWORK=comment_edit_delete_default
KASM_BROWSER_PROFILES_VOLUME=comment_edit_delete_browser-profiles
KASM_PUBLIC_SCHEME=https
KASM_PUBLIC_HOST=localhost
KASM_VNC_PASSWORD=change-me-visible-browser-password
KASM_EMBED_CREDENTIALS_IN_URL=true
# Optional production template for Kasm/KasmVNC or a browser gateway.
# Example: https://browser.example.com/session/{account_id}
REMOTE_BROWSER_URL_TEMPLATE=

# Production reverse proxy
APP_DOMAIN=example.com
ACME_EMAIL=admin@example.com
# When using Caddy/Nginx same-origin proxy in production, use:
# NEXT_PUBLIC_API_URL=https://example.com
# CORS_ORIGINS=https://example.com
NGINX_PORT=8080

# Optional: real PostgreSQL URL used by pytest integration tests.
TEST_DATABASE_URL=postgresql+asyncpg://flowmeta:change-me@localhost:5432/flowmeta_test

# Gemini AI API Key
GEMINI_API_KEY=
# Flow Studio clip scoring model. gemini-1.5-flash and gemini-2.5-flash now 404
# with "no longer available to new users"; check ListModels before changing.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_THINKING_LEVEL=minimal
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_SECONDS=0.75
LLM_TIMEOUT_SECONDS=120

# Free local speech recognition, tuned for laptop CPU speed.
ASR_WHISPER_MODEL=small
ASR_COMPUTE_TYPE=int8
ASR_CPU_THREADS=8
ASR_BEAM_SIZE=1
# 0 = one region at a time. Batching needs faster-whisper >= 1.1; the pinned
# 1.0.3 is both faster and byte-identical to the evaluation baseline.
ASR_BATCH_SIZE=0
# Empty = detect from the first hot region and reuse it for the rest of the job.
# Set it ("vi", "en", …) when every source is the same language: whisper-small
# misreads accented speech often enough to tag a whole job wrong.
ASR_LANGUAGE=

# Flow Studio keeps jobs and generated media for one day after the last
# heartbeat, then the Flow worker removes both files and database records.
CLIP_RETENTION_ENABLED=true
CLIP_SESSION_GRACE_SECONDS=86400
CLIP_SWEEP_INTERVAL_SECONDS=60
# Cached transcripts, per user. The key folds in the ASR model, the compute
# type, the pipeline version and the prefilter settings, so changing any of
# them invalidates the cache on its own.
# Download the audio track first so ASR runs while the video is still coming
# down. false = one combined download, the old behaviour.
CLIP_SOURCE_AUDIO_FIRST=true
CLIP_ANALYSIS_CACHE_ENABLED=true
CLIP_ANALYSIS_TTL_DAYS=14

# Gen/Reup voice-over and stock images.
TTS_BACKEND=edge
TTS_DEFAULT_VOICE=vi-female
TTS_TIMEOUT_SECONDS=30
TTS_MAX_RETRIES=1
TTS_RETRY_BASE_SECONDS=0.5
TTS_MAX_TEMPO=1.6
PEXELS_API_KEY=
STOCK_TIMEOUT_SECONDS=20
GEN_SCENE_PAD_SEC=0.4
GEN_MAX_DURATION_SEC=120
GEN_MAX_UPLOAD_IMAGES=12
GEN_MAX_IMAGE_BYTES=15728640

# Flow pipeline concurrency, one limit per resource the work actually uses.
# FLOW_CPU_SLOTS=0 means auto (cores - 1). Raising it above the core count
# makes encodes fight each other instead of finishing sooner.
FLOW_CPU_SLOTS=0
FLOW_NET_SLOTS=8
FLOW_TTS_SLOTS=4
